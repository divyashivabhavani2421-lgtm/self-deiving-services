# ============================================================================
# Supabase Edge Functions Secrets Template (NAMES ONLY — DO NOT COMMIT VALUES)
# Configure real values ONLY in Supabase Dashboard -> Edge Functions -> Secrets
# or via `supabase secrets set ...` CLI.
# Never prefix these with VITE_ and never put real secrets in frontend code.
# ============================================================================

# Activation gate: keep "false" until Meta WhatsApp Cloud API setup and
# number migration/registration for 6302543640 are intentionally completed.
WHATSAPP_ENABLED="false"

# Meta WhatsApp Cloud API credentials (server-side Supabase secrets only)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_SENDER_NUMBER="916302543640"

# Business/Admin recipient WhatsApp number in digits with country code
WHATSAPP_ADMIN_PHONE="916302543640"

# Approved Meta WhatsApp template names & language code
WHATSAPP_TEMPLATE_ADMIN_NEW_BOOKING="admin_new_booking_alert"
WHATSAPP_TEMPLATE_CUSTOMER_CONFIRMED="customer_booking_confirmed"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_GRAPH_API_VERSION="v22.0"

# Internal dispatch secret (for Supabase Database Webhooks / scheduled retries)
WHATSAPP_DISPATCH_SECRET=""

# Meta Webhook verification & payload signature verification secrets
META_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
