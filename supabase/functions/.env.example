# ============================================================================
# Supabase Edge Functions Secrets Template (NAMES ONLY — DO NOT COMMIT VALUES)
# Configure real values ONLY in Supabase Dashboard -> Edge Functions -> Secrets
# or via `supabase secrets set ...` CLI.
# Never prefix these with VITE_ and never put real secrets in frontend code.
# ============================================================================

# Activation gate: keep "false" by default until intentionally testing Zernio Sandbox.
WHATSAPP_ENABLED="false"

# Zernio provider mode: MUST remain "sandbox" (production mode is blocked in code).
ZERNIO_MODE="sandbox"

# Zernio server-side API key (already configured in Supabase Edge Function Secrets;
# never expose in frontend code or commit real values).
ZERNIO_API_KEY=""

# Optional explicit Zernio Sandbox accountId override (auto-discovered via GET /v1/phone-numbers if empty)
ZERNIO_SANDBOX_ACCOUNT_ID=""

# Zernio Sandbox supports only the activated single test phone (+916302543640)
ZERNIO_SANDBOX_RECIPIENT="916302543640"
WHATSAPP_ADMIN_PHONE="916302543640"

# Historical pending-event safeguards:
# Keep ZERNIO_ALLOW_UNSCOPED_BATCH="false" so turning WHATSAPP_ENABLED="true"
# never sweeps older queued bookings automatically. Optionally set an ISO timestamp
# in WHATSAPP_PROCESS_AFTER to restrict batch queue runs to events created after that time.
ZERNIO_ALLOW_UNSCOPED_BATCH="false"
WHATSAPP_PROCESS_AFTER=""

# Internal dispatch secret (for Supabase Database Webhooks / scheduled retries)
WHATSAPP_DISPATCH_SECRET=""

# Legacy Meta Webhook verification secrets (if needed for webhook endpoint compatibility)
META_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
